# Copy to .env and fill in. Nothing here is read at import time, so the app
# still starts with values missing -- it reports which ones on /api/health.

# --- credentials -------------------------------------------------------------
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=replace-with-qdrant-api-key
GEMINI_API_KEY=replace-with-gemini-api-key

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random secret is generated per process and every session is lost
# on restart.
SESSION_SECRET=replace-with-a-long-random-string

# --- models ------------------------------------------------------------------
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-2
# The model emits 3072 numbers per passage by default and supports truncation to
# shorter widths. 768 is four times smaller with very little retrieval loss,
# which is what keeps the index inside a free Qdrant cluster.
EMBEDDING_DIMENSIONS=768

# --- storage -----------------------------------------------------------------
# Note: this differs from the pre-hybrid name. The collection layout changed
# (named dense + sparse vectors), so a collection created by an older version
# cannot be reused and the app will say so rather than silently misbehave.
QDRANT_COLLECTION=sourcesync_hybrid
MAX_SESSION_PASSAGES=4000
# How often to sweep passages whose session has expired. Nothing tells the server
# when a visitor leaves, so expiry is the boundary and this enforces it.
PURGE_INTERVAL_MINUTES=10

# --- retrieval tuning --------------------------------------------------------
# Passages each search returns before fusion.
RETRIEVAL_CANDIDATES=20
# Passages that survive reranking and are shown to the model.
CONTEXT_PASSAGES=6
# Room for the answer. Too low truncates answers mid-sentence.
ANSWER_MAX_TOKENS=1200
# Gemini reasoning budget before answering. 0 is fastest and cheapest; raise to
# around 1024 if answers need more synthesis. Use -1 to leave the model on its
# default, which is the only value the -lite models accept.
ANSWER_THINKING_BUDGET=-1

# --- web ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173
SESSION_TTL_MINUTES=60
# true on HTTPS (required for the cross-origin cookie), false for local HTTP.
SESSION_COOKIE_SECURE=false
